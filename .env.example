# Copy to .env and uncomment what you want to override. Every value shown is the
# code default; each backend service validates its vars via a Zod config module
# at boot. Not auto-loaded: `set -a; source .env; set +a`

# --- Shared infrastructure (aggregator + all ingestors) ---
NATS_URL=nats://localhost:4222
MONGO_URL=mongodb://localhost:27017/price_oracle

# --- Aggregator: connection & HTTP ---
# AGGREGATOR_HTTP_PORT=7402
# CORS_ORIGIN=http://localhost:5173
# Unset -> deterministic stub adapter (diagnose runs end-to-end with no secrets).
# ANTHROPIC_API_KEY=

# --- Aggregator: feed composition ---
# AGGREGATOR_ASSETS=btc,eth
# mock-only stable demo; real/mixed is opt-in: binance,coinbase[,mock]
# AGGREGATOR_SOURCES=mock
# AGGREGATION_INTERVAL_MS=500

# --- Aggregator: source-health thresholds (DEGRADED <= STALE <= FRESHNESS_DECAY) ---
# DEGRADED_AFTER_MS=5000
# STALE_AFTER_MS=12000
# FRESHNESS_DECAY_MS=12000
# HEALTH_HYSTERESIS_STREAK=3

# --- Aggregator: circuit breaker ---
# BREAKER_CONFIDENCE_FLOOR=0.6
# BREAKER_TRIP_STREAK=6
# BREAKER_RECOVERY_WINDOW_MS=30000
# BREAKER_HALF_OPEN_PROBE_STREAK=4

# --- Aggregator: anomaly detection ---
# ANOMALY_DRIFT_TOLERANCE=2
# ANOMALY_STREAK_LENGTH=6

# --- Mock ingestor ---
# MOCK_HTTP_PORT=7401
# MOCK_TICK_INTERVAL_MS=250
# Seed near recent spot so mock + real sources agree at baseline (no network fetch).
# MOCK_BTC_ANCHOR_USD=76000
# MOCK_ETH_ANCHOR_USD=2070
# MOCK_PRICE_VOLATILITY_PCT=0.001
# Dev-only chaos API; never enable in production.
# MOCK_ADMIN_ENABLED=false

# --- Binance ingestor ---
# BINANCE_WS_URL=wss://stream.binance.com:9443/stream?streams=btcusdt@trade/ethusdt@trade

# --- Coinbase ingestor ---
# COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# --- Dashboard (Vite dev server) ---
# Blank -> same-origin; the dev server proxies /api and /admin.
# VITE_API_BASE_URL=
# Proxy targets reuse AGGREGATOR_HTTP_PORT and MOCK_HTTP_PORT (above).
