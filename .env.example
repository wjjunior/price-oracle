# Not auto-loaded: `set -a; source .env; set +a`
#
# Local infrastructure connection URLs.
# Every backend service reads these via its Zod-validated config module at boot.

NATS_URL=nats://localhost:4222
MONGO_URL=mongodb://localhost:27017/price_oracle

# Optional third-party endpoint overrides.
# These default to the exchanges' public combined-stream endpoints in each
# ingestor's config schema, so they are NOT required to run locally. Uncomment
# only to point an ingestor at a mock/proxy (e.g. for offline testing).
# BINANCE_WS_URL=wss://stream.binance.com:9443/stream?streams=btcusdt@trade/ethusdt@trade

# Optional LLM diagnose key.
# When set, the aggregator's diagnose endpoint calls the Anthropic API. When
# unset, it falls back to a deterministic stub so the system runs end-to-end
# with no secrets. Uncomment and provide a real key to exercise the live path.
# ANTHROPIC_API_KEY=sk-ant-...
