{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@price-oracle/contracts/events": ["packages/contracts/src/events/index.ts"],
      "@price-oracle/contracts/primitives": ["packages/contracts/src/primitives.ts"],
      "@price-oracle/contracts/rest": ["packages/contracts/src/rest/index.ts"],
      "@price-oracle/contracts/sse": ["packages/contracts/src/sse/envelope.ts"],
      "@price-oracle/contracts/subjects": ["packages/contracts/src/subjects.ts"]
    }
  }
}
